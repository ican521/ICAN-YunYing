<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 纯 Compose 应用：使用平台 NoActionBar 主题，不含任何 Leanback 样式 -->
    <style name="Theme.TvPlay" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="r">shortEdges</item>
        <!-- 平台 Dialog 窗口遮罩（播放页倍速/缓冲/音轨/字幕等底部弹窗）：
             取值必须与 Kotlin 常量 PopupScrim(0x66000000) 保持一致（黑色 40%，深浅主题一致） -->
        <item name="android:backgroundDimAmount">0.4</item>
    </style>

    <!-- 平台 Dialog 专用主题：只覆盖窗口动画（遮罩 200ms 淡入淡出，与 ScrimFadeMillis 一致）。
         不挂在 Activity 主题上，避免影响页面转场；
         由 BottomSlideDialog 用 ContextThemeWrapper 仅包裹对应 Dialog 生效 -->
    <style name="Theme.TvPlay.Dialog" parent="Theme.TvPlay">
        <item name="android:windowAnimationStyle">@style/ScrimDialogAnimation</item>
    </style>

    <!-- 弹窗窗口动画：遮罩随窗口整体 200ms 淡入/淡出，卡片自身的上下滑动不受影响 -->
    <style name="ScrimDialogAnimation" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/scrim_fade_in</item>
        <item name="android:windowExitAnimation">@anim/scrim_fade_out</item>
    </style>

</resources>
